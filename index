<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>Construction Controls Chart Studio</title>
<style id="pageStyle">
  @page { size: A4 landscape; margin: 8mm; }
</style>
<style>
:root{
  --bg:#eef2f7;--panel:#ffffff;--ink:#172033;--muted:#68758b;--line:#dfe6ef;--accent:#0c5bd8;--accent2:#15a36d;
  --shadow:0 14px 42px rgba(31,47,70,.12);--radius:16px;
  --page-w:1123px;--page-h:794px;--page-scale:.78;
}
*{box-sizing:border-box} body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:var(--ink);height:100vh;overflow:hidden}
button,input,select{font:inherit}.app{display:grid;grid-template-columns:360px 1fr;height:100vh}
.sidebar{background:#0f172a;color:#e7edf8;overflow:auto;padding:18px;border-right:1px solid #1f2a44}
.brand{display:flex;gap:12px;align-items:center;margin-bottom:16px}.brandmark{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#0c5bd8,#42a5ff);display:grid;place-items:center;font-weight:900;box-shadow:0 8px 24px rgba(12,91,216,.35)}
.brand h1{font-size:16px;margin:0 0 3px}.brand p{font-size:11px;margin:0;color:#95a3bb}.group{background:#141f35;border:1px solid #24324d;border-radius:14px;padding:12px;margin:10px 0}.group h3{font-size:12px;text-transform:uppercase;letter-spacing:.12em;margin:0 0 10px;color:#99a8c2}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px}.field{margin:8px 0}.field label{display:block;font-size:11px;color:#aebad0;margin-bottom:5px}.field input,.field select{width:100%;border:1px solid #31405e;background:#0f172a;color:#eff5ff;border-radius:9px;padding:8px 9px;outline:none}.field input[type=checkbox]{width:auto}
.rowchecks{display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;color:#d7e0ef}.rowchecks label{display:flex;align-items:center;gap:7px}
.btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}.btn{border:1px solid #34435f;background:#1b2a45;color:#eef4ff;border-radius:10px;padding:9px 10px;cursor:pointer;font-weight:700;font-size:12px}.btn.primary{background:#0c5bd8;border-color:#0c5bd8}.btn.good{background:#0f8c62;border-color:#0f8c62}.btn.warn{background:#8a5a0a;border-color:#8a5a0a}.btn:hover{filter:brightness(1.08)}
.workspace{overflow:auto;position:relative}.topbar{position:sticky;top:0;z-index:5;height:62px;background:rgba(255,255,255,.94);backdrop-filter:blur(12px);border-bottom:1px solid #dbe3ef;display:flex;align-items:center;justify-content:space-between;padding:0 18px}.topbar .title{font-weight:800}.topbar .hint{font-size:12px;color:#728097}.status{font-size:11px;background:#eaf6ef;color:#167447;border:1px solid #b8e3ca;border-radius:999px;padding:6px 10px}
.canvasWrap{min-width:900px;padding:24px;display:flex;flex-direction:column;align-items:center;gap:20px}.paper-shell{transform-origin:top center;transform:scale(var(--page-scale));margin-bottom:calc((var(--page-h) * (var(--page-scale) - 1)) + 4px)}
.paper{width:var(--page-w);height:var(--page-h);background:white;box-shadow:var(--shadow);border-radius:4px;position:relative;padding:34px 42px 30px;display:grid;grid-template-rows:auto 1fr auto;gap:16px;overflow:hidden}
.paper::before{content:"";position:absolute;left:0;right:0;top:0;height:6px;background:linear-gradient(90deg,#0c5bd8,#1bb0dc,#15a36d)}
.reportHeader{display:flex;justify-content:space-between;gap:28px;align-items:flex-start;border-bottom:1px solid #e4e9f1;padding-bottom:14px}.reportHeader h2{font-size:24px;margin:0 0 5px;letter-spacing:-.02em}.reportHeader p{margin:0;color:#69778e;font-size:12px}.meta{text-align:right;font-size:11px;color:#738096;line-height:1.6}.meta strong{color:#263349}.chartFrame{border:1px solid #e4e9f2;border-radius:14px;padding:14px 16px 10px;display:grid;grid-template-rows:auto 1fr;min-height:0}.chartHead{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:8px}.chartHead h3{margin:0;font-size:18px}.chartHead p{margin:4px 0 0;font-size:11px;color:#77849a}.metricBadge{font-size:11px;border:1px solid #d7e3f3;background:#f5f8fc;border-radius:999px;padding:6px 9px;color:#526176}.chartArea{min-height:0;position:relative}.chartArea canvas{width:100%;height:100%;display:block}.foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid #e4e9f1;padding-top:10px;font-size:10px;color:#7b8799}.foot b{color:#344158}
.dataDock{width:min(1280px,calc(100vw - 420px));background:white;border:1px solid #dfe6ef;border-radius:16px;box-shadow:0 10px 30px rgba(32,48,72,.08);overflow:hidden}.dockHead{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;border-bottom:1px solid #e4e9f1}.dockHead h3{font-size:13px;margin:0}.dockHead p{font-size:11px;color:#7c899d;margin:2px 0 0}.tableWrap{max-height:310px;overflow:auto}.dataTable{border-collapse:collapse;width:100%;font-size:11px}.dataTable th{position:sticky;top:0;background:#f5f8fc;z-index:1;color:#526176;font-size:10px;text-transform:uppercase;letter-spacing:.05em}.dataTable th,.dataTable td{border:1px solid #e6ebf2;padding:0}.dataTable input{width:100%;border:0;background:white;padding:7px 8px;min-width:72px;color:#28354b}.dataTable input:focus{outline:2px solid #84b3ff;outline-offset:-2px;background:#f7fbff}.remove{border:0;background:#fff;color:#b42318;width:28px;cursor:pointer;font-weight:900}
.note{font-size:10px;color:#8390a5;line-height:1.45}.chiprow{display:flex;flex-wrap:wrap;gap:6px}.chip{border:1px solid #34435f;background:#15223a;color:#dce6f7;border-radius:999px;padding:6px 9px;font-size:11px;cursor:pointer}.chip.active{background:#0c5bd8;border-color:#0c5bd8;color:white}
@media print{
 body{background:white;overflow:visible}.app{display:block;height:auto}.sidebar,.topbar,.dataDock{display:none!important}.workspace{overflow:visible}.canvasWrap{padding:0;display:block}.paper-shell{transform:none!important;margin:0!important}.paper{box-shadow:none;border-radius:0;width:auto;height:auto;min-height:0;padding:8mm 10mm}.chartFrame{height:calc(100vh - 48mm)}
}
@media (max-width:1100px){.app{grid-template-columns:320px 1fr}.sidebar{padding:14px}.dataDock{width:calc(100vw - 350px)}}
</style>
</head>
<body>
<div class="app">
  <aside class="sidebar">
    <div class="brand"><div class="brandmark">PC</div><div><h1>Project Controls Chart Studio</h1><p>Construction manpower • cash flow • S-curves • analytics</p></div></div>

    <div class="group">
      <h3>Chart library</h3>
      <div class="chiprow" id="chartChips"></div>
    </div>

    <div class="group">
      <h3>Titles & project</h3>
      <div class="field"><label>Project name</label><input id="projectName" value="Mega Infrastructure Project" /></div>
      <div class="field"><label>Chart title</label><input id="chartTitle" value="Manpower Histogram" /></div>
      <div class="field"><label>Subtitle</label><input id="chartSubtitle" value="Monthly manpower deployment by resource class" /></div>
      <div class="grid2">
        <div class="field"><label>Report ref.</label><input id="reportRef" value="PC-CH-001" /></div>
        <div class="field"><label>Revision</label><input id="revision" value="R0" /></div>
      </div>
    </div>

    <div class="group">
      <h3>Chart styling</h3>
      <div class="grid2">
        <div class="field"><label>Palette</label><select id="palette"><option value="corporate">Corporate</option><option value="emerald">Emerald</option><option value="gold">Gold</option><option value="mono">Monochrome</option><option value="vivid">Vivid</option></select></div>
        <div class="field"><label>Theme</label><select id="theme"><option value="light">Light</option><option value="soft">Soft gray</option><option value="dark">Dark print</option></select></div>
      </div>
      <div class="grid2">
        <div class="field"><label>Font scale</label><select id="fontScale"><option value="1">100%</option><option value="0.9">90%</option><option value="1.1">110%</option><option value="1.2">120%</option></select></div>
        <div class="field"><label>Bar gap</label><select id="barGap"><option value="0.18">Normal</option><option value="0.05">Tight</option><option value="0.32">Wide</option></select></div>
      </div>
      <div class="rowchecks">
        <label><input type="checkbox" id="showLegend" checked> Legend</label>
        <label><input type="checkbox" id="showGrid" checked> Gridlines</label>
        <label><input type="checkbox" id="showLabels"> Data labels</label>
        <label><input type="checkbox" id="smooth" checked> Smooth curves</label>
      </div>
    </div>

    <div class="group">
      <h3>Paper & export</h3>
      <div class="grid2">
        <div class="field"><label>Paper</label><select id="paperSize"><option value="A4">A4</option><option value="A3">A3</option></select></div>
        <div class="field"><label>Orientation</label><select id="orientation"><option value="landscape">Landscape</option><option value="portrait">Portrait</option></select></div>
      </div>
      <div class="btns">
        <button class="btn primary" id="printBtn">Print / PDF</button>
        <button class="btn good" id="pngBtn">Chart PNG</button>
        <button class="btn" id="csvBtn">Export CSV</button>
        <button class="btn" id="jsonBtn">Export JSON</button>
        <button class="btn" id="importBtn">Import CSV/JSON</button>
        <button class="btn" id="htmlBtn">Download HTML</button>
      </div>
      <input type="file" id="fileInput" accept=".csv,.json" hidden>
      <p class="note">PDF uses the browser print dialog with the selected A4/A3 and orientation. PNG exports the current chart at high resolution.</p>
    </div>

    <div class="group">
      <h3>Data tools</h3>
      <div class="btns"><button class="btn" id="addRowBtn">+ Add period</button><button class="btn warn" id="resetBtn">Reset sample</button></div>
      <p class="note">Edit cells directly in the table below the page. Charts redraw instantly.</p>
    </div>
  </aside>

  <main class="workspace">
    <div class="topbar"><div><div class="title">Dynamic Project Controls Visualization Studio</div><div class="hint">Editable HTML • print-ready project controls graphics</div></div><div class="status" id="status">Live preview</div></div>
    <div class="canvasWrap">
      <div class="paper-shell">
        <section class="paper" id="paper">
          <div class="reportHeader">
            <div><h2 id="projectOut">Mega Infrastructure Project</h2><p>Planning & Project Controls • Dynamic analytics report</p></div>
            <div class="meta"><strong id="refOut">PC-CH-001</strong><br><span id="revOut">Revision R0</span><br><span id="dateOut"></span></div>
          </div>
          <div class="chartFrame">
            <div class="chartHead"><div><h3 id="titleOut">Manpower Histogram</h3><p id="subtitleOut">Monthly manpower deployment by resource class</p></div><div class="metricBadge" id="metricBadge">Resources</div></div>
            <div class="chartArea"><canvas id="chartCanvas"></canvas></div>
          </div>
          <div class="foot"><span>Source: editable project-control dataset in this studio.</span><span><b id="paperOut">A4 • Landscape</b> • Generated from Project Controls Chart Studio</span></div>
        </section>
      </div>

      <section class="dataDock">
        <div class="dockHead"><div><h3>Editable data grid</h3><p>Periods, resources, cash flow and progress data. Click any cell to edit.</p></div><div class="status" id="rowStatus">12 periods</div></div>
        <div class="tableWrap"><table class="dataTable" id="dataTable"></table></div>
      </section>
    </div>
  </main>
</div>
<script>
(() => {
  const qs = s => document.querySelector(s);
  const paletteMap = {
    corporate:['#0c5bd8','#22a7e0','#15a36d','#f2a900','#7a5af8','#d94a64','#526176'],
    emerald:['#0b6b57','#11a37f','#67c4a6','#96d7c3','#c4eadf','#2f7f73','#183c36'],
    gold:['#745100','#b8860b','#e3b23c','#f0cd74','#765827','#c27a17','#4d3a12'],
    mono:['#1f2937','#4b5563','#6b7280','#9ca3af','#c4c9d0','#374151','#111827'],
    vivid:['#2251ff','#ff2e63','#16c79a','#f9a826','#8a4fff','#00a8cc','#ff7a00']
  };
  const chartDefs = [
    ['manpower','Manpower'],['stackedManpower','Stacked MP'],['cashflow','Cash Flow'],['cumcash','Cum. Cash'],['scurve','S-Curve'],['earned','Earned Value'],['bar','Bar'],['hbar','H-Bar'],['line','Line'],['area','Area'],['pie','Pie'],['donut','Donut'],['combo','Combo'],['variance','Variance'],['waterfall','Waterfall'],['scatter','Scatter']
  ];
  const sample = [
    ['Jan',18,42,8,12,0.8,1.4,5,4,3],['Feb',24,58,10,16,1.1,1.8,11,9,8],['Mar',31,72,12,20,1.7,2.4,18,15,14],['Apr',39,85,14,23,2.3,2.9,27,23,21],['May',46,96,16,25,3.1,3.5,38,33,31],['Jun',52,108,17,29,3.8,4.0,50,45,43],['Jul',55,114,18,31,4.6,4.5,62,57,55],['Aug',50,105,18,30,5.0,4.7,73,68,66],['Sep',44,92,16,26,5.4,4.2,82,77,75],['Oct',36,76,14,22,5.2,3.8,90,86,84],['Nov',28,57,12,17,4.6,3.1,96,92,90],['Dec',20,41,9,13,3.6,2.4,100,97,96]
  ];
  let data = sample.map(r => ({period:r[0],skilled:r[1],unskilled:r[2],staff:r[3],equipment:r[4],inflow:r[5],outflow:r[6],planned:r[7],actual:r[8],earned:r[9]}));
  let chartType='manpower';
  const headers=[['period','Period'],['skilled','Skilled'],['unskilled','Unskilled'],['staff','Staff'],['equipment','Equip.'],['inflow','Inflow M'],['outflow','Outflow M'],['planned','Planned %'],['actual','Actual %'],['earned','EV %']];

  function initChips(){
    qs('#chartChips').innerHTML = chartDefs.map(([v,l])=>`<button class="chip ${v===chartType?'active':''}" data-chart="${v}">${l}</button>`).join('');
    document.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{chartType=b.dataset.chart;syncChartMeta();initChips();draw();});
  }
  function renderTable(){
    let h='<thead><tr>'+headers.map(x=>`<th>${x[1]}</th>`).join('')+'<th></th></tr></thead><tbody>';
    data.forEach((r,i)=>{h+='<tr>'+headers.map(([k])=>`<td><input data-i="${i}" data-k="${k}" value="${r[k]}"></td>`).join('')+`<td><button class="remove" data-rm="${i}">×</button></td></tr>`});
    h+='</tbody>'; qs('#dataTable').innerHTML=h; qs('#rowStatus').textContent=`${data.length} periods`;
    qs('#dataTable').querySelectorAll('input').forEach(inp=>inp.addEventListener('input',e=>{const i=+e.target.dataset.i,k=e.target.dataset.k;data[i][k]=k==='period'?e.target.value:(parseFloat(e.target.value)||0);draw();}));
    qs('#dataTable').querySelectorAll('[data-rm]').forEach(b=>b.onclick=()=>{if(data.length>2){data.splice(+b.dataset.rm,1);renderTable();draw();}});
  }

  function fitCanvas(){const c=qs('#chartCanvas'),r=c.parentElement.getBoundingClientRect(),d=Math.min(2,window.devicePixelRatio||1);c.width=Math.max(600,Math.round(r.width*d));c.height=Math.max(360,Math.round(r.height*d));return {c,ctx:c.getContext('2d'),w:c.width,h:c.height,d};}
  function palette(){return paletteMap[qs('#palette').value]||paletteMap.corporate}
  function totalMP(r){return +r.skilled + +r.unskilled + +r.staff}
  function max(arr){return Math.max(...arr.filter(Number.isFinite),1)}
  function min(arr){return Math.min(...arr.filter(Number.isFinite),0)}
  function shortNum(n){const a=Math.abs(n);if(a>=1e9)return(n/1e9).toFixed(1)+'B';if(a>=1e6)return(n/1e6).toFixed(1)+'M';if(a>=1e3)return(n/1e3).toFixed(1)+'k';return (Math.round(n*10)/10).toString()}

  function draw(){
    const {c,ctx,w,h,d}=fitCanvas(); const p=palette(); const dark=qs('#theme').value==='dark'; const soft=qs('#theme').value==='soft';
    const bg=dark?'#111827':soft?'#f7f9fc':'#ffffff', ink=dark?'#ecf2fb':'#2c384b', muted=dark?'#9fb0c9':'#7b8799', grid=dark?'#2b3951':'#e7ecf3';
    ctx.clearRect(0,0,w,h);ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);ctx.font=`${Math.round(12*d*(+qs('#fontScale').value))}px Inter,Arial`;ctx.lineWidth=d;
    const margin={l:70*d,r:34*d,t:34*d,b:64*d}; const W=w-margin.l-margin.r,H=h-margin.t-margin.b;
    const labels=data.map(r=>r.period);
    const showGrid=qs('#showGrid').checked, showLabels=qs('#showLabels').checked;
    const legend=[];
    function axes(ymin,ymax,unit='',zero=false){
      ctx.save();ctx.strokeStyle=grid;ctx.fillStyle=muted;ctx.textAlign='right';ctx.textBaseline='middle';
      const ticks=5; for(let i=0;i<=ticks;i++){let v=ymin+(ymax-ymin)*i/ticks;let y=margin.t+H-(i/ticks)*H;if(showGrid){ctx.beginPath();ctx.moveTo(margin.l,y);ctx.lineTo(margin.l+W,y);ctx.stroke();}ctx.fillText(shortNum(v)+unit,margin.l-10*d,y)}
      ctx.textAlign='center';ctx.textBaseline='top';labels.forEach((lab,i)=>{let x=margin.l+(i+.5)*W/labels.length;ctx.fillText(lab,x,margin.t+H+12*d)});
      if(zero && ymin<0 && ymax>0){let zy=margin.t+H-(0-ymin)/(ymax-ymin)*H;ctx.strokeStyle=dark?'#8290a7':'#8d99aa';ctx.beginPath();ctx.moveTo(margin.l,zy);ctx.lineTo(margin.l+W,zy);ctx.stroke()}
      ctx.restore(); return v=>margin.t+H-(v-ymin)/(ymax-ymin)*H;
    }
    function barSeries(vals,color,offset,count,yfn,label,stackBase=null){
      legend.push([label,color]); const bw=W/labels.length*(1-(+qs('#barGap').value)); const sw=bw/count; ctx.fillStyle=color;
      vals.forEach((v,i)=>{const x=margin.l+i*W/labels.length+(W/labels.length-bw)/2+offset*sw;const y0=stackBase?yfn(stackBase[i]):yfn(0),y1=yfn((stackBase?stackBase[i]:0)+v);ctx.fillRect(x,Math.min(y0,y1),sw-2*d,Math.max(1*d,Math.abs(y0-y1)));if(showLabels){ctx.fillStyle=ink;ctx.textAlign='center';ctx.textBaseline='bottom';ctx.fillText(shortNum(v),x+(sw-2*d)/2,Math.min(y0,y1)-4*d);ctx.fillStyle=color}})
    }
    function lineSeries(vals,color,label,yfn,width=2.5,fill=false){
      legend.push([label,color]);ctx.save();ctx.strokeStyle=color;ctx.lineWidth=width*d;ctx.lineJoin='round';ctx.lineCap='round';const pts=vals.map((v,i)=>[margin.l+(i+.5)*W/vals.length,yfn(v)]);ctx.beginPath();pts.forEach((pt,i)=>i?ctx.lineTo(...pt):ctx.moveTo(...pt));ctx.stroke();if(fill){ctx.lineTo(pts[pts.length-1][0],margin.t+H);ctx.lineTo(pts[0][0],margin.t+H);ctx.closePath();ctx.globalAlpha=.12;ctx.fillStyle=color;ctx.fill();ctx.globalAlpha=1}ctx.fillStyle=color;pts.forEach((pt,i)=>{ctx.beginPath();ctx.arc(pt[0],pt[1],3.2*d,0,Math.PI*2);ctx.fill();if(showLabels){ctx.fillStyle=ink;ctx.textAlign='center';ctx.fillText(shortNum(vals[i]),pt[0],pt[1]-9*d);ctx.fillStyle=color}});ctx.restore();
    }
    function legendDraw(){if(!qs('#showLegend').checked||!legend.length)return;ctx.save();ctx.font=`${11*d}px Inter,Arial`;let x=margin.l,y=12*d;legend.forEach(([lab,col])=>{ctx.fillStyle=col;ctx.fillRect(x,y,12*d,8*d);ctx.fillStyle=muted;ctx.textAlign='left';ctx.textBaseline='middle';ctx.fillText(lab,x+17*d,y+4*d);x+=ctx.measureText(lab).width+45*d});ctx.restore()}
    function pie(donut=false){
      const vals=[data.reduce((a,r)=>a+r.skilled,0),data.reduce((a,r)=>a+r.unskilled,0),data.reduce((a,r)=>a+r.staff,0),data.reduce((a,r)=>a+r.equipment,0)], names=['Skilled','Unskilled','Staff','Equipment']; const sum=vals.reduce((a,b)=>a+b,0); const cx=w*.42,cy=h*.50,rad=Math.min(W,H)*.34;let a=-Math.PI/2;
      vals.forEach((v,i)=>{let da=(v/sum)*Math.PI*2;ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,rad,a,a+da);ctx.closePath();ctx.fillStyle=p[i];ctx.fill();legend.push([names[i],p[i]]);if(showLabels){let mid=a+da/2;ctx.fillStyle=dark?'#fff':'#fff';ctx.textAlign='center';ctx.textBaseline='middle';ctx.font=`bold ${12*d}px Inter,Arial`;ctx.fillText(Math.round(v/sum*100)+'%',cx+Math.cos(mid)*rad*.67,cy+Math.sin(mid)*rad*.67)}a+=da});
      if(donut){ctx.beginPath();ctx.arc(cx,cy,rad*.52,0,Math.PI*2);ctx.fillStyle=bg;ctx.fill();ctx.fillStyle=ink;ctx.textAlign='center';ctx.font=`bold ${22*d}px Inter,Arial`;ctx.fillText(shortNum(sum),cx,cy-3*d);ctx.font=`${10*d}px Inter,Arial`;ctx.fillStyle=muted;ctx.fillText('TOTAL',cx,cy+17*d)}
      let lx=w*.72,ly=h*.32;ctx.font=`${12*d}px Inter,Arial`;names.forEach((n,i)=>{ctx.fillStyle=p[i];ctx.fillRect(lx,ly+i*34*d,14*d,14*d);ctx.fillStyle=ink;ctx.textAlign='left';ctx.fillText(n,lx+22*d,ly+i*34*d+11*d);ctx.fillStyle=muted;ctx.fillText(shortNum(vals[i]),lx+120*d,ly+i*34*d+11*d)});
    }

    const mp=data.map(totalMP), plan=data.map(r=>+r.planned), act=data.map(r=>+r.actual), ev=data.map(r=>+r.earned), inflow=data.map(r=>+r.inflow), outflow=data.map(r=>+r.outflow), net=data.map((r,i)=>inflow[i]-outflow[i]);
    const cum=[];net.reduce((a,v,i)=>cum[i]=a+v,0);let y;
    if(chartType==='manpower') {y=axes(0,Math.ceil(max([...data.map(r=>r.skilled),...data.map(r=>r.unskilled),...data.map(r=>r.staff)])/25)*25);barSeries(data.map(r=>+r.skilled),p[0],0,3,y,'Skilled');barSeries(data.map(r=>+r.unskilled),p[1],1,3,y,'Unskilled');barSeries(data.map(r=>+r.staff),p[2],2,3,y,'Staff');}
    else if(chartType==='stackedManpower'){y=axes(0,Math.ceil(max(mp)/50)*50);const z=data.map(()=>0),s1=data.map(r=>+r.skilled),s2=data.map(r=>+r.unskilled);barSeries(s1,p[0],0,1,y,'Skilled',z);barSeries(s2,p[1],0,1,y,'Unskilled',s1);barSeries(data.map(r=>+r.staff),p[2],0,1,y,'Staff',s1.map((v,i)=>v+s2[i]));}
    else if(chartType==='cashflow'){y=axes(0,Math.ceil(max([...inflow,...outflow,...cum.map(Math.abs)])/2)*2,'M');barSeries(inflow,p[2],0,2,y,'Inflow');barSeries(outflow,p[5],1,2,y,'Outflow');lineSeries(cum,p[0],'Cumulative Net',y,3);}
    else if(chartType==='cumcash'){let ymin=Math.min(0,Math.floor(min(cum))),ymax=Math.max(1,Math.ceil(max(cum)));y=axes(ymin,ymax,'M',true);lineSeries(cum,p[0],'Cumulative Net Cash',y,3,true);}
    else if(chartType==='scurve'){y=axes(0,100,'%');lineSeries(plan,p[0],'Planned',y,3);lineSeries(act,p[2],'Actual',y,3);}
    else if(chartType==='earned'){y=axes(0,100,'%');lineSeries(plan,p[0],'Planned',y,2.6);lineSeries(act,p[2],'Actual',y,2.6);lineSeries(ev,p[3],'Earned Value',y,2.6);}
    else if(chartType==='bar'){y=axes(0,Math.ceil(max(mp)/50)*50);barSeries(mp,p[0],0,1,y,'Total Manpower');}
    else if(chartType==='hbar'){
      const vmax=Math.ceil(max(mp)/50)*50;ctx.fillStyle=muted;ctx.textAlign='right';ctx.textBaseline='middle';const rowH=H/data.length; if(showGrid){for(let j=0;j<=5;j++){let x=margin.l+W*j/5;ctx.strokeStyle=grid;ctx.beginPath();ctx.moveTo(x,margin.t);ctx.lineTo(x,margin.t+H);ctx.stroke();ctx.fillText(shortNum(vmax*j/5),x,margin.t+H+22*d)}}data.forEach((r,i)=>{let y0=margin.t+i*rowH+rowH*.18;ctx.fillStyle=p[0];ctx.fillRect(margin.l,y0,W*(mp[i]/vmax),rowH*.62);ctx.fillStyle=muted;ctx.textAlign='right';ctx.fillText(r.period,margin.l-10*d,y0+rowH*.31);if(showLabels){ctx.fillStyle=ink;ctx.textAlign='left';ctx.fillText(mp[i],margin.l+W*(mp[i]/vmax)+6*d,y0+rowH*.31)}});legend.push(['Total Manpower',p[0]]);
    }
    else if(chartType==='line'){y=axes(0,100,'%');lineSeries(plan,p[0],'Planned',y,3);lineSeries(act,p[2],'Actual',y,3);}
    else if(chartType==='area'){y=axes(0,100,'%');lineSeries(plan,p[0],'Planned',y,2.5,true);lineSeries(act,p[2],'Actual',y,2.5,true);}
    else if(chartType==='pie'){pie(false)}
    else if(chartType==='donut'){pie(true)}
    else if(chartType==='combo'){
      y=axes(0,Math.ceil(max(mp)/50)*50);barSeries(mp,p[0],0,1,y,'Total Manpower');const yy=v=>margin.t+H-(v/100)*H;lineSeries(act,p[3],'Actual Progress %',yy,3);ctx.fillStyle=muted;ctx.textAlign='left';for(let i=0;i<=5;i++)ctx.fillText((i*20)+'%',margin.l+W+8*d,margin.t+H-(i/5)*H)
    }
    else if(chartType==='variance'){const v=data.map((r,i)=>act[i]-plan[i]);let m=Math.ceil(max(v.map(Math.abs))/5)*5||5;y=axes(-m,m,'%',true);barSeries(v,p[5],0,1,y,'Actual - Planned');}
    else if(chartType==='waterfall'){
      let running=0,vals=[];net.forEach(v=>{let s=running;running+=v;vals.push([s,running,v])});let lo=Math.min(0,...vals.flatMap(x=>[x[0],x[1]])),hi=Math.max(0,...vals.flatMap(x=>[x[0],x[1]]));y=axes(Math.floor(lo)-1,Math.ceil(hi)+1,'M',true);const bw=W/data.length*.58;vals.forEach((a,i)=>{let x=margin.l+i*W/data.length+(W/data.length-bw)/2,yy0=y(a[0]),yy1=y(a[1]);ctx.fillStyle=a[2]>=0?p[2]:p[5];ctx.fillRect(x,Math.min(yy0,yy1),bw,Math.max(2*d,Math.abs(yy0-yy1)));if(i<vals.length-1){ctx.strokeStyle=grid;ctx.beginPath();ctx.moveTo(x+bw,yy1);ctx.lineTo(x+W/data.length,yy1);ctx.stroke()}});legend.push(['Positive Net',p[2]],['Negative Net',p[5]]);
    }
    else if(chartType==='scatter'){
      const xmin=0,xmax=100,ymin=0,ymax=100;ctx.fillStyle=muted;ctx.textAlign='right';for(let i=0;i<=5;i++){let xx=margin.l+W*i/5,yy=margin.t+H-H*i/5;if(showGrid){ctx.strokeStyle=grid;ctx.beginPath();ctx.moveTo(xx,margin.t);ctx.lineTo(xx,margin.t+H);ctx.stroke();ctx.beginPath();ctx.moveTo(margin.l,yy);ctx.lineTo(margin.l+W,yy);ctx.stroke()}ctx.fillText(i*20+'%',margin.l-10*d,yy);ctx.textAlign='center';ctx.fillText(i*20+'%',xx,margin.t+H+18*d);ctx.textAlign='right'}ctx.fillStyle=p[0];data.forEach((r,i)=>{let x=margin.l+(r.planned-xmin)/(xmax-xmin)*W,yy=margin.t+H-(r.actual-ymin)/(ymax-ymin)*H;ctx.beginPath();ctx.arc(x,yy,5*d,0,Math.PI*2);ctx.fill();if(showLabels){ctx.fillStyle=ink;ctx.textAlign='center';ctx.fillText(r.period,x,yy-10*d);ctx.fillStyle=p[0]}});ctx.strokeStyle=p[3];ctx.setLineDash([6*d,5*d]);ctx.beginPath();ctx.moveTo(margin.l,margin.t+H);ctx.lineTo(margin.l+W,margin.t);ctx.stroke();ctx.setLineDash([]);legend.push(['Planned vs Actual',p[0]],['Parity Line',p[3]]);
    }
    legendDraw();
    qs('#status').textContent='Live preview • '+chartDefs.find(x=>x[0]===chartType)[1];
  }

  function syncChartMeta(){
    const meta={manpower:['Manpower Histogram','Monthly manpower deployment by resource class','Resources'],stackedManpower:['Stacked Manpower Histogram','Resource composition across project periods','Resources'],cashflow:['Cash Flow Histogram + Curve','Monthly inflow/outflow with cumulative net cash curve','Currency (M)'],cumcash:['Cumulative Cash Flow Curve','Running net project cash position','Currency (M)'],scurve:['Project Progress S-Curve','Planned versus actual cumulative progress','Completion %'],earned:['Earned Value Curves','Planned, actual and earned-value progress','Completion %'],bar:['Total Manpower Bar Chart','Total labor resources by period','Resources'],hbar:['Horizontal Manpower Bars','Period-by-period total manpower','Resources'],line:['Progress Line Chart','Planned and actual progress trend','Completion %'],area:['Progress Area Chart','Planned and actual progress with area emphasis','Completion %'],pie:['Resource Composition Pie','Aggregate resource distribution','Resource share'],donut:['Resource Composition Donut','Aggregate resource distribution','Resource share'],combo:['Manpower + Progress Combo','Total manpower bars with actual progress curve','Dual metric'],variance:['Schedule Variance Bars','Actual minus planned progress by period','Variance %'],waterfall:['Net Cash Waterfall','Period net cash contribution to running position','Currency (M)'],scatter:['Planned vs Actual Scatter','Progress correlation by period','Progress %']};
    qs('#chartTitle').value=meta[chartType][0];qs('#chartSubtitle').value=meta[chartType][1];qs('#metricBadge').textContent=meta[chartType][2];syncText();
  }
  function syncText(){qs('#projectOut').textContent=qs('#projectName').value;qs('#titleOut').textContent=qs('#chartTitle').value;qs('#subtitleOut').textContent=qs('#chartSubtitle').value;qs('#refOut').textContent=qs('#reportRef').value;qs('#revOut').textContent='Revision '+qs('#revision').value;qs('#dateOut').textContent=new Date().toLocaleDateString(undefined,{year:'numeric',month:'short',day:'2-digit'});}
  function setPaper(){const a=qs('#paperSize').value,o=qs('#orientation').value;const mm=a==='A3'?[420,297]:[297,210];const dims=o==='landscape'?mm:mm.reverse();const px=dims.map(v=>Math.round(v*3.78));document.documentElement.style.setProperty('--page-w',px[0]+'px');document.documentElement.style.setProperty('--page-h',px[1]+'px');let avail=Math.max(620,window.innerWidth-430);document.documentElement.style.setProperty('--page-scale',Math.min(.9,(avail-60)/px[0]));qs('#pageStyle').textContent=`@page { size: ${a} ${o}; margin: 8mm; }`;qs('#paperOut').textContent=`${a} • ${o[0].toUpperCase()+o.slice(1)}`;setTimeout(draw,80)}
  function setTheme(){const paper=qs('#paper'),t=qs('#theme').value;if(t==='dark'){paper.style.background='#111827';paper.style.color='#eef4ff'}else if(t==='soft'){paper.style.background='#f7f9fc';paper.style.color='#172033'}else{paper.style.background='#fff';paper.style.color='#172033'}draw()}
  function download(name,content,type){const blob=new Blob([content],{type});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove()},600)}
  function csv(){const ks=headers.map(h=>h[0]);return [ks.join(','),...data.map(r=>ks.map(k=>r[k]).join(','))].join('\n')}
  function parseCSV(txt){const lines=txt.trim().split(/\r?\n/).filter(Boolean),keys=lines.shift().split(',').map(x=>x.trim());return lines.map(line=>{const v=line.split(',');let r={};keys.forEach((k,i)=>r[k]=k==='period'?(v[i]||''):(parseFloat(v[i])||0));return r})}
  function doImport(file){const fr=new FileReader();fr.onload=()=>{try{let d=file.name.toLowerCase().endsWith('.json')?JSON.parse(fr.result):parseCSV(fr.result);if(Array.isArray(d)&&d.length){data=d;renderTable();draw();qs('#status').textContent='Imported '+data.length+' periods'}}catch(e){alert('Could not import this file. Check the CSV/JSON structure.')}};fr.readAsText(file)}

  initChips(); renderTable(); syncText(); setPaper();
  ['projectName','chartTitle','chartSubtitle','reportRef','revision'].forEach(id=>qs('#'+id).addEventListener('input',syncText));
  ['palette','fontScale','barGap','showLegend','showGrid','showLabels','smooth'].forEach(id=>qs('#'+id).addEventListener('change',draw));
  qs('#theme').onchange=setTheme;qs('#paperSize').onchange=setPaper;qs('#orientation').onchange=setPaper;window.addEventListener('resize',setPaper);
  qs('#printBtn').onclick=()=>window.print();
  qs('#pngBtn').onclick=()=>{const c=qs('#chartCanvas');const a=document.createElement('a');a.download=(qs('#chartTitle').value||'chart').replace(/[^a-z0-9]+/gi,'_')+'.png';a.href=c.toDataURL('image/png',1);a.click()};
  qs('#csvBtn').onclick=()=>download('project_controls_data.csv',csv(),'text/csv');
  qs('#jsonBtn').onclick=()=>download('project_controls_data.json',JSON.stringify(data,null,2),'application/json');
  qs('#importBtn').onclick=()=>qs('#fileInput').click();qs('#fileInput').onchange=e=>{if(e.target.files[0])doImport(e.target.files[0]);e.target.value=''};
  qs('#htmlBtn').onclick=()=>download('construction_chart_studio.html','<!doctype html>\n'+document.documentElement.outerHTML,'text/html');
  qs('#addRowBtn').onclick=()=>{data.push({period:'P'+(data.length+1),skilled:0,unskilled:0,staff:0,equipment:0,inflow:0,outflow:0,planned:0,actual:0,earned:0});renderTable();draw()};
  qs('#resetBtn').onclick=()=>{data=sample.map(r=>({period:r[0],skilled:r[1],unskilled:r[2],staff:r[3],equipment:r[4],inflow:r[5],outflow:r[6],planned:r[7],actual:r[8],earned:r[9]}));renderTable();draw()};
})();
</script>
